{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@luna/*": ["packages/addons/*"],
      "@vendor/*": ["packages/vendor/*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "scripts/**/*.ts",
    "packages/entry/src/**/*.ts",
    "packages/main/src/**/*.ts",
    "packages/addons/**/*.ts",
    "packages/renderers/main/src/components/**/*.ts",
    "packages/renderers/main/src/router/**/*.ts"
  ]
}
